# Generate API_TOKEN and CREDENTIAL_KEY using the setup command. Never share .env.
DATABASE_URL=postgresql+psycopg://outreach:outreach@localhost:5432/outreach
API_TOKEN=
CREDENTIAL_KEY=
DATA_DIR=data
API_URL=http://127.0.0.1:8000
SENDING_ENABLED=false
DRY_RUN=true
ALLOW_RECRUITER_DELIVERY=false
SENDER_EMAIL=
SENDER_NAME=
TEST_RECIPIENT=
DAILY_SEND_LIMIT=5
CONTACT_COOLDOWN_DAYS=30
COMPANY_COOLDOWN_DAYS=7
TIMEZONE=Asia/Kolkata
SCHEDULE_HOUR=9
# Configure company boards in dashboard. Domains must be checked by the user.
SOURCE_BOARDS=[]
OAUTH_CLIENT_FILE=data/credentials.json
# Optional compatible provider. No LLM requests are made by the default workflow.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
SEMANTIC_THRESHOLD=0.25
LLM_CALLS_PER_RUN=10
